{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": { 
        "outputDirectory": "build" 
      }
    }
  ],
  "rewrites": [
    
    { 
      "source": "/static/(.*)", 
      "destination": "/static/$1" 
    },
    
    { 
      "source": "/images/(.*)", 
      "destination": "/images/$1" 
    },
    
    { 
      "source": "/(.*)", 
      "destination": "/index.html" 
    }
  ]
}